tools/ortho.jpg
tools/data.js

# macOS
.DS_Store

# Lokala Claude-inställningar
.claude/settings.local.json

# graphify: kunskapsgrafen committas (billig kodnavigering för nya sessioner),
# men extraktionscache och temporärfiler är lokala
graphify-out/cache/
graphify-out/.graphify_*
tools/cache/

# v2 (ny motor, Vite/TypeScript): beroenden och byggutdata
